import os
import numpy as np
import tifffile as tiff

# absortion spectrum index, select for each folder of images
index = "1750"

# 1. Directory Setup
base_path = r"C:\Users\Samuel_Uni\psi-sim-dmr-nanocatalysts\Images_and_Data\ni_ru_v4"
image_folder = os.path.join(base_path, f"20260918_{index}_AbsortionSpectrum")
txt_path = os.path.join(image_folder, "scan_1.txt")
output_dir = os.path.join(base_path, f"Keithley_normalised_images_{index}")

os.makedirs(output_dir, exist_ok=True)

# 2. Load scan metadata
data = np.loadtxt(txt_path, delimiter=";", skiprows=1, usecols=[1, 2, 4])
keithley_norm_factor = data[:, 2] * 10**8  # 1D array of factors per frame

# 3. Get sorted TIFF files to ensure 1-to-1 index matching
tiff_files = sorted(
    [f for f in os.listdir(image_folder) if f.lower().endswith((".tiff", ".tif"))]
)
#print(len(keithley_norm_factor), len(tiff_files))

# Just for plotting purposes, not necessary for the normalisation
# intensity_region_1 = data[:, 0]
# intensity_region_2 = data[:, 1]


# 4. Loop through images, normalize, and save individual zero-padded files
for i, file in enumerate(tiff_files):
    filepath = os.path.join(image_folder, file)
    try:
        image = tiff.imread(filepath)

        # Normalize pixel values using the frame's specific Keithley factor and cast to float32
        normalised_image = (image / keithley_norm_factor[i]).astype(np.float32)

        # Save individual zero-padded ImageJ-compatible files (e.g., frame_0000.tif)
        padded_filename = f"frame_{i:04d}.tif"
        out_filepath = os.path.join(output_dir, padded_filename)
        tiff.imwrite(out_filepath, normalised_image, imagej=True)

    except Exception as e:
        print(f"Error processing {file}: {e}")

